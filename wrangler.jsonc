{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "savanna-trails",
  "main": "worker.js",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "secrets": {
    "required": [
      "RESEND_API_KEY"
    ]
  }
}
